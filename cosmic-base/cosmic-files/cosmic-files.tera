{% extends "base.tera" %}

{%- block header -%}
# Copyright {{ this_year }} Fabio Scaccabarozzi
# Distributed under the terms of the GNU General Public License v3

# Auto-Generated by cargo-ebuild {{ cargo_ebuild_ver }}
{% endblock %}

{% block inherit -%}cargo desktop xdg{%- endblock %}

{% block variables %}
IUSE+=" afp http mtp nfs samba"

DEPEND="
	dev-libs/glib:2
"
RDEPEND="
	${DEPEND}
	x11-misc/xdg-utils
	>=gnome-base/gvfs-1.48.0[afp?,http?,mtp?,nfs?,samba?]
	~cosmic-base/cosmic-icons-${PV}
"
{% endblock %}

{% block phases %}
src_compile() {
	cargo_src_compile
	cargo_src_compile --package "${PN}-applet"
}

src_install() {
	dobin "target/release/${PN}"
	dobin "target/release/${PN}-applet"

	domenu target/xdgen/com.system76.CosmicFiles.desktop

	insinto /usr/share/metainfo
	doins target/xdgen/com.system76.CosmicFiles.metainfo.xml

	insinto /usr/share/icons/hicolor
	doins -r res/icons/hicolor/*

	einstalldocs
}
{% endblock %}
